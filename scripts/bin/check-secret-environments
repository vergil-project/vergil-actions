#!/usr/bin/env bash
# check-secret-environments — fail when a workflow job reads a secret that
# can write or act without declaring the environment that holds it
# (vergil-project/vergil-actions#1339, epic vergil-project/.github#1384).
#
# The org automation App's keys and the registry publishing tokens live in
# each repository's `automation` environment, whose deployment-branch
# policy admits only `develop` and `main`. A job outside that environment
# sees them unset, so a workflow run from any other branch cannot mint the
# App token or publish. The package-signing keys keep their own
# single-branch environments (`package-signing`, `index-signing`).
#
# Usage: check-secret-environments <repo-root>
#
# Reads every tracked .github/workflows/*.yml and *.yaml. For each job that
# runs steps (a job that calls a reusable workflow with `uses:` runs none:
# the called workflow's own jobs are what read the secret), it collects every
# `secrets.<NAME>` named inside a `${{ }}` expression anywhere in the job,
# case-insensitively and skipping quoted string literals, and checks each
# against the tables below. A secret no table lists, a dynamic read of the
# secrets context (`secrets[...]`, `toJSON(secrets)`), a secret read in the
# workflow-level env, an environment named by an expression and a workflow
# that does not parse all fail: nothing passes unclassified.
#
# It also fails a reusable workflow that declares a secret `required: true`
# under on.workflow_call.secrets and has a job with no literal environment
# name (vergil-project/vergil-actions#1428). GitHub checks a called
# workflow's required secrets for each of its jobs, and a secret that exists
# only in an environment is not provided to a job that declares none (not
# even through `secrets: inherit`), so GitHub refuses the whole call before
# any job starts. Such a secret is declared `required: false` instead, and
# each job that reads it fails loudly when it is empty. A job that calls
# another reusable workflow cannot declare an environment, so it is named
# too.
set -euo pipefail

# Secrets that can write or act, read only in the `automation` environment.
AUTOMATION_SECRETS=(
	APP_CLIENT_ID
	APP_PRIVATE_KEY
	CARGO_REGISTRY_TOKEN
)
# Signing secrets, read only in one of their own signing environments.
SIGNING_SECRETS=(
	PACKAGE_SIGNING_KEY
	PACKAGE_SIGNING_PASSPHRASE
)
SIGNING_ENVIRONMENTS=(package-signing index-signing)
# Secrets any job may read with no environment, one "<name>|<reason>" each.
UNSCOPED_SECRETS=(
	"GITHUB_TOKEN|the run's own token, limited by each job's permissions: block"
	"CONAN_AUDIT_PROVIDER_TOKEN_CONANCENTER|a read-only vulnerability database key that PR-time CI reads for the C/C++ audit (vergil-project/.github#1391)"
)

if [[ "$#" -ne 1 ]]; then
	echo "usage: check-secret-environments <repo-root>" >&2
	exit 2
fi
root="$1"

if ! command -v yq >/dev/null 2>&1; then
	echo "ERROR: check-secret-environments needs yq (mikefarah v4) on PATH" >&2
	exit 1
fi
if ! listing="$(git -C "$root" -c core.quotePath=false ls-files -- \
	'.github/workflows/*.yml' '.github/workflows/*.yaml')"; then
	echo "ERROR: could not list the workflows tracked in git" >&2
	exit 1
fi
if [[ -z "$listing" ]]; then
	echo "ERROR: no workflows under .github/workflows/ are tracked in git" >&2
	exit 1
fi

# secret_reads — read text on stdin; print each secret named inside a
# `${{ }}` expression, upper-cased, one per line, or `*` for a read of the
# secrets context with no literal name after it.
secret_reads() {
	tr '\n' ' ' | awk '
		{
			s = $0
			while ((i = index(s, "${{")) > 0) {
				s = substr(s, i + 3)
				j = index(s, "}}")
				if (j > 0) { e = substr(s, 1, j - 1); s = substr(s, j + 2) } else { e = s; s = "" }
				e = tolower(e)
				gsub(/\047[^\047]*\047/, "", e)
				while (match(e, /secrets/)) {
					before = (RSTART > 1) ? substr(e, RSTART - 1, 1) : ""
					rest = substr(e, RSTART + RLENGTH)
					e = rest
					if (before ~ /[a-z0-9_.-]/) continue
					if (rest ~ /^[a-z0-9_-]/) continue
					if (match(rest, /^[ ]*\.[ ]*[a-z_][a-z0-9_-]*/)) {
						name = substr(rest, 1, RLENGTH)
						gsub(/[ .]/, "", name)
						print toupper(name)
					} else {
						print "*"
					}
				}
			}
		}
	'
}

# in_list <word> <list...> — whether <word> is one of <list>.
in_list() {
	local w="$1" x
	shift
	for x in "$@"; do
		[[ "$x" == "$w" ]] && return 0
	done
	return 1
}

unscoped_names=()
for entry in "${UNSCOPED_SECRETS[@]}"; do
	unscoped_names+=("${entry%%|*}")
done

rc=0
count=0
while IFS= read -r wf; do
	path="$root/$wf"
	if [[ ! -f "$path" ]]; then
		echo "ERROR: $wf: (workflow): tracked workflow is missing from the working tree" >&2
		rc=1
		continue
	fi
	if ! yq -e 'tag == "!!map"' "$path" >/dev/null 2>&1; then
		echo "ERROR: $wf: (workflow): does not parse as a YAML mapping" >&2
		rc=1
		continue
	fi
	count=$((count + 1))

	# The workflow-level env reaches every job, so no secret but an
	# unscoped one may be read there.
	if ! reads="$(yq -r '[del(.jobs) | .. | select(tag == "!!str")] | .[]' "$path" | secret_reads)"; then
		echo "ERROR: $wf: (workflow): could not read the workflow" >&2
		rc=1
		continue
	fi
	while IFS= read -r name; do
		[[ -n "$name" ]] || continue
		in_list "$name" "${unscoped_names[@]}" && continue
		echo "ERROR: $wf: (workflow): reads secret $name outside any job, where every job sees it; read it in the job that needs it" >&2
		rc=1
	done <<<"$(sort -u <<<"$reads")"

	# The secrets this workflow, when called, declares `required: true`,
	# space-separated.
	if ! required="$(yq -r '[(.on | select(tag == "!!map") | .workflow_call | select(tag == "!!map") |
		.secrets | select(tag == "!!map") | to_entries | .[] |
		select(.value | tag == "!!map") | select(.value.required == true) | .key)] | join(" ")' "$path")"; then
		echo "ERROR: $wf: (workflow): could not read its workflow_call secrets" >&2
		rc=1
		continue
	fi

	if ! jobs="$(yq -r '(.jobs // {}) | keys | .[]' "$path")"; then
		echo "ERROR: $wf: (workflow): could not list its jobs" >&2
		rc=1
		continue
	fi
	while IFS= read -r job; do
		[[ -n "$job" ]] || continue
		if ! uses="$(J="$job" yq -r '.jobs[strenv(J)] | has("uses")' "$path")" ||
			! tag="$(J="$job" yq -r '.jobs[strenv(J)].environment | tag' "$path")"; then
			echo "ERROR: $wf: $job: could not read the job" >&2
			rc=1
			continue
		fi
		case "$tag" in
		'!!null') env="" ;;
		'!!str') env="$(J="$job" yq -r '.jobs[strenv(J)].environment' "$path")" ;;
		'!!map') env="$(J="$job" yq -r '.jobs[strenv(J)].environment.name // ""' "$path")" ;;
		*) env="<${tag}>" ;;
		esac
		shown="${env:-none}"
		# A required secret needs a literal environment name on every job.
		# shellcheck disable=SC2016 # a literal GitHub Actions expression opener
		if [[ -n "$required" ]] && [[ -z "$env" || "$env" == *'${{'* || "$env" == '<'* ]]; then
			echo "ERROR: $wf: $job: declares environment $shown, but the workflow declares $required required: true; GitHub refuses the call when a required secret exists only in an environment and a job declares none. Declare it required: false and fail loudly in each job that reads it" >&2
			rc=1
		fi
		if [[ "$uses" == "true" ]]; then
			continue
		fi
		if ! reads="$(J="$job" yq -r '[.jobs[strenv(J)] | .. | select(tag == "!!str")] | .[]' "$path" | secret_reads)"; then
			echo "ERROR: $wf: $job: could not read the job" >&2
			rc=1
			continue
		fi
		while IFS= read -r name; do
			[[ -n "$name" ]] || continue
			if [[ "$name" == "*" ]]; then
				echo "ERROR: $wf: $job: reads the secrets context without naming a secret; name each secret it reads" >&2
				rc=1
			elif in_list "$name" "${unscoped_names[@]}"; then
				continue
			elif in_list "$name" "${AUTOMATION_SECRETS[@]}"; then
				if [[ "$env" != "automation" ]]; then
					echo "ERROR: $wf: $job: reads $name, which can write or act, but declares environment $shown; declare environment: automation" >&2
					rc=1
				fi
			elif in_list "$name" "${SIGNING_SECRETS[@]}"; then
				if ! in_list "$env" "${SIGNING_ENVIRONMENTS[@]}"; then
					echo "ERROR: $wf: $job: reads signing secret $name but declares environment $shown; declare one of ${SIGNING_ENVIRONMENTS[*]}" >&2
					rc=1
				fi
			else
				echo "ERROR: $wf: $job: reads secret $name, which no table in scripts/bin/check-secret-environments classifies; add it to the table for the environment that holds it" >&2
				rc=1
			fi
		done <<<"$(sort -u <<<"$reads")"
	done <<<"$jobs"
done <<<"$listing"

if [[ "$rc" -eq 0 ]]; then
	echo "Secret environments: $count workflows OK"
fi
exit "$rc"
