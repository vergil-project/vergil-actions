#!/usr/bin/env bash
# validate-custom — repo-local validation hook discovered by
# vrg-validate. Checks the git mode of every *.test.sh script and that
# every *.test.sh suite is run by a workflow or by validation, checks that
# no pipeline feeds an early-exit consumer (grep -q, head), that every
# write-capable secret is read in its environment, and that the nightly
# harness run calls every smoke workflow, runs the
# action test suites under actions/**/tests/, then runs the tests of
# these checks under scripts/tests/.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

status=0

# Every *.test.sh tracked in git at $1 must have mode 100755, so each
# test script can be run directly and its mode cannot drift (#1201).
# Checks the mode git records, not the one on disk: a checkout restores
# the recorded mode, so that is the one that ships.
check_test_script_modes() {
	local root="$1" listing entry meta path mode rc=0 count=0
	# core.quotePath=false names a non-ASCII path as is; a path holding a tab,
	# newline or quote is still quoted by git, so it stays on one line.
	if ! listing="$(git -C "$root" -c core.quotePath=false ls-files --stage -- '*.test.sh')"; then
		echo "ERROR: could not list the *.test.sh scripts tracked in git" >&2
		return 1
	fi
	while IFS= read -r entry; do
		[[ -n "$entry" ]] || continue
		count=$((count + 1))
		meta="${entry%%$'\t'*}"
		path="${entry#*$'\t'}"
		mode="${meta%% *}"
		if [[ "$mode" != "100755" ]]; then
			echo "ERROR: $path: test script has git mode $mode, must be 100755 (executable)" >&2
			rc=1
		fi
	done <<<"$listing"
	if [[ "$count" -eq 0 ]]; then
		echo "ERROR: no *.test.sh scripts are tracked in git" >&2
		rc=1
	fi
	if [[ "$rc" -eq 0 ]]; then
		echo "Test script modes: $count test scripts OK"
	fi
	return "$rc"
}

# The action suites validation leaves to the CI workflow that runs them,
# one "<path>|<reason>" entry each. Every other actions/**/tests/*.test.sh
# suite runs here. An entry must name a tracked action suite: a stale one
# fails the run rather than hide a renamed suite.
CI_ONLY_ACTION_SUITES=(
	"actions/shared/setup/vergil/tests/install-tooling.test.sh|its missing_pin_fails case runs read-pin.sh on PATH /usr/bin:/bin, which holds python3 on the runner but not in the validation image (only /usr/local/bin does)"
)

# Run every action suite tracked in git at $1 (the actions/**/tests/*.test.sh
# scripts) from the repo root, as CI does, except those in
# CI_ONLY_ACTION_SUITES, which are named as skipped (#1108).
run_action_suites() {
	local root="$1" listing path entry rc=0 count=0 skipped=0
	if ! listing="$(git -C "$root" -c core.quotePath=false ls-files -- 'actions/*.test.sh')"; then
		echo "ERROR: could not list the action test suites tracked in git" >&2
		return 1
	fi
	for entry in "${CI_ONLY_ACTION_SUITES[@]}"; do
		path="${entry%%|*}"
		if ! grep -qxF -- "$path" <<<"$listing"; then
			echo "ERROR: $path: listed as CI-only but is not a tracked action suite" >&2
			rc=1
		fi
	done
	while IFS= read -r path; do
		[[ "$path" =~ ^actions/.+/tests/[^/]+\.test\.sh$ ]] || continue
		for entry in "${CI_ONLY_ACTION_SUITES[@]}"; do
			if [[ "${entry%%|*}" == "$path" ]]; then
				echo "Skipping (CI only: ${entry#*|}): $path"
				skipped=$((skipped + 1))
				continue 2
			fi
		done
		count=$((count + 1))
		echo "Running: $path"
		# </dev/null: a suite must not read the listing that feeds this loop.
		if ! (cd "$root" && bash "$path" </dev/null); then
			echo "ERROR: $path: test suite failed" >&2
			rc=1
		fi
	done <<<"$listing"
	if [[ "$count" -eq 0 ]]; then
		echo "ERROR: no action test suites to run are tracked in git" >&2
		rc=1
	fi
	if [[ "$rc" -eq 0 ]]; then
		echo "Action test suites: $count run, $skipped left to CI"
	fi
	return "$rc"
}

# Sourced (by the test-script-modes tests): define the checks, run nothing.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
	return 0
fi

echo "Running: test script mode check"
check_test_script_modes "$ROOT" || status=1

echo "Running: test suite wiring check"
"$ROOT/scripts/bin/check-test-suites-run" "$ROOT" || status=1

echo "Running: early-exit pipe check"
"$ROOT/scripts/bin/check-early-exit-pipes" "$ROOT" || status=1

echo "Running: secret environment check"
"$ROOT/scripts/bin/check-secret-environments" "$ROOT" || status=1
echo "Running: nightly harness check"
"$ROOT/scripts/bin/check-nightly-harnesses" "$ROOT" || status=1

echo "Running: action test suites"
run_action_suites "$ROOT" || status=1

for t in "$ROOT"/scripts/tests/*.test.sh; do
	echo "Running: $t"
	bash "$t" || status=1
done
exit "$status"
